{
  "name": "biobuzz",
  "productName": "BIOBUZZ",
  "version": "1.4.0",
  "description": "BIOBUZZ — FTC field simulator",
  "author": "BIOBUZZ",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "org.apollo9662.biobuzz",
    "productName": "BIOBUZZ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "sync.js",
      "bridge.js",
      "sim/**",
      "pad/**",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BIOBUZZ",
      "artifactName": "BIOBUZZ-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "BIOBUZZ-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yaarilevrosen-cpu",
        "repo": "BIOBUZZ",
        "releaseType": "release"
      }
    ],
    "copyright": "BIOBUZZ contributors"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yaarilevrosen-cpu/BIOBUZZ.git"
  }
}