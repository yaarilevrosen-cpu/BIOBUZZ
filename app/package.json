{
  "name": "biobuzz",
  "productName": "BIOBUZZ",
  "version": "1.14.0",
  "description": "BIOBUZZ — FTC field simulator",
  "author": {
    "name": "BIOBUZZ",
    "email": "biobuzz@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64",
    "dist:linux": "electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "org.apollo9662.biobuzz",
    "productName": "BIOBUZZ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "sync.js",
      "bridge.js",
      "ai.js",
      "sim/**",
      "pad/**",
      "build/icon.png"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BIOBUZZ",
      "artifactName": "BIOBUZZ-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "license": "build/license.txt",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "BIOBUZZ-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yaarilevrosen-cpu",
        "repo": "BIOBUZZ",
        "releaseType": "release"
      }
    ],
    "copyright": "BIOBUZZ contributors",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "BIOBUZZ-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "BIOBUZZ ${version}${arch}",
      "artifactName": "BIOBUZZ-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game;Education",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "BIOBUZZ <biobuzz@users.noreply.github.com>",
      "synopsis": "FTC field simulator",
      "executableName": "biobuzz",
      "artifactName": "BIOBUZZ-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "BIOBUZZ-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "BIOBUZZ-${version}-linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "../ai",
        "to": "ai",
        "filter": [
          "*.md",
          "*.json"
        ]
      },
      {
        "from": "../legal",
        "to": "legal",
        "filter": [
          "*.md",
          "VERSION"
        ]
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yaarilevrosen-cpu/BIOBUZZ.git"
  },
  "homepage": "https://yaarilevrosen-cpu.github.io/BIOBUZZ/"
}
